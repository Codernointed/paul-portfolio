# Copy to .env.local for local dev, and set the same keys in the Vercel project
# (Settings > Environment Variables) for production.

# --- PostHog analytics (client-side, safe to expose) ---
# Project API key from https://app.posthog.com (Project Settings)
REACT_APP_PUBLIC_POSTHOG_KEY=phc_your_project_key
# Use https://eu.i.posthog.com if you picked the EU region on sign-up
REACT_APP_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Resend email (SERVER-SIDE ONLY, never expose in client code) ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# Where contact-form messages are delivered
CONTACT_TO_EMAIL=botchweypaul0001@gmail.com
# Verified sender. Until you verify paulbotchwey.com in Resend, you can use:
#   Portfolio <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Paul Botchwey <hello@paulbotchwey.com>
